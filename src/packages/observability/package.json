{
  "name": "@cantilune/observability",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Cantilune observability — EventSpine read-models (diagrams/03-observability/)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @cantilune/observability... build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @cantilune/observability... build",
    "test:coverage": "vitest run --coverage",
    "test:pack": "node scripts/pack-consumer-smoke.mjs"
  },
  "dependencies": {
    "@cantilune/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "devDependencies": {
    "@cantilune/runtime": "workspace:*",
    "@cantilune/test-fixtures": "workspace:*",
    "@vitest/coverage-v8": "^3.2.7"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
