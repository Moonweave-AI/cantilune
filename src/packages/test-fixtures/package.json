{
  "name": "@cantilune/test-fixtures",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared Cantilune story fixtures for core and runtime tests",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cantilune/core": "workspace:*"
  }
}
