{
  "name": "@cantilune/syscall",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "LLM <-> Cantilune OS translation layer: perceive, act, content, tool",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pack": "node ../../../scripts/packConsumerSmoke.mjs syscall",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:static": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "@cantilune/core": "workspace:*",
    "@cantilune/runtime": "workspace:*",
    "@cantilune/content": "workspace:*"
  },
  "peerDependencies": {
    "@cantilune/observability": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cantilune/observability": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7"
  }
}
