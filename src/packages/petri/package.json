{
  "name": "@cantilune/petri",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Cantilune Petri-net firing engine: token-game semantics, bounded reachability, and place-invariant analysis over the PNML structural net",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cantilune/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
