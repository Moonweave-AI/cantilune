{
  "name": "@cantilune/content",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Content-addressed storage for Cantilune: resolve ContentRef to actual bytes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/adapters/memory/index.d.ts",
      "import": "./dist/adapters/memory/index.js"
    },
    "./file": {
      "types": "./dist/adapters/file/index.d.ts",
      "import": "./dist/adapters/file/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:static": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "@cantilune/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7"
  }
}
