{
  "name": "@cantilune/evaluation",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claims": {
      "types": "./dist/claims/index.d.ts",
      "import": "./dist/claims/index.js"
    },
    "./benchmarks": {
      "types": "./dist/benchmarks/index.d.ts",
      "import": "./dist/benchmarks/index.js"
    },
    "./datasets": {
      "types": "./dist/datasets/index.d.ts",
      "import": "./dist/datasets/index.js"
    },
