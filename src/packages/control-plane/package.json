{
  "name": "@cantilune/control-plane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cantilune control-plane — schema/policy admission and epoch activation",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "import": "./dist/file/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cantilune/conformance": "workspace:*",
    "@cantilune/core": "workspace:*",
    "@cantilune/runtime": "workspace:*"
  },
  "devDependencies": {
    "@cantilune/comms": "workspace:*",
    "@cantilune/test-fixtures": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7"
  }
}
