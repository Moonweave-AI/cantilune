title 图 01A · @cantilune/core 协作域模型：Snapshot、Change 与 Structure
caption <color:#6E6963>对齐 src/packages/core/。案例：task-T 委派。虚线框为 runtime 层（非 core 导出）；实线框为 core 已实现类型。</color>

legend top right
  |= 颜色 |= 工程语义 |
  | <back:#E5EDE5>　</back> | nodes + CollaborationSnapshot：协作世界持久化状态 |
  | <back:#F3E5DC>　</back> | coordination：CoordinationChange / Intent |
  | <back:#EDE8F0>　</back> | structure：Agent 组合原语与 RunHistory |
  | <back:#E5ECEE>　</back> | Runtime 边界（@cantilune/runtime，非 core） |
  | <back:#E8EEF5>　</back> | consistency：世界完整性校验 |
  | <back:#F5F1EB>　</back> | ObservationEntry：外部输入有序留痕 |
endlegend

frame "Cantilune 核心域模型 · 三柱 + Runtime 可追溯边界" #F8F5F0 {

  package "nodes · 协作网实体" #E5EDE5 {

    class "Participant\nActor 常驻注册" as Participant #F9FCF8 {
      +actorId: ActorId
      .. 例：planner-p；生命周期内不复用 ..
      +kind: ActorKind
      .. human / agent / tool / reviewer / runtime / environment ..
      +status: ParticipationStatus
      .. active / waiting / blocked / retired ..
    }

    class "WorkArtifact\n可传递工作产物" as Artifact #FFFDFC {
      +artifactId: ArtifactId
      .. 例：task-T ..
      +kind: string
      .. Task / Plan / Evidence / Draft / Deliverable ..
      +contentRef: ContentRef
      .. 例：content://task-T；正文不进 Change ..
      +owner: ActorRef
      .. 例：(actorId=planner-p, kind=agent) ..
      +lifecycle: ArtifactLifecycle
      .. proposed / active / reviewable / published / retired ..
    }

    class "ScopedCapability\n线性稀缺能力" as Capability #FFFDFC {
      +capabilityId: CapabilityId
      .. 例：write-lock-w ..
      +kind: CapabilityKind
      .. write_lock / budget_slot / approval_slot / tool_lease ..
      +holder: ActorId
      .. 例：coder-c；唯一持有者 ..
      +scope: CapabilityScope
      .. (artifact=task-T) 或 (session=session-s) ..
    }

    class "CommunicationSession\n通信会话" as Session #FFFDFC {
      +sessionId: SessionId
      .. 例：session-s ..
      +controller: ActorId
      .. 例：coder-c ..
      +participants: List<ActorId>
      .. 例：[coder-c, planner-p] ..
      +visibility: SessionVisibility
      .. private / shared ..
    }

    class "CollaborationLink\n有向协作关系" as Link #FFFDFC {
      +linkId: LinkId
      .. 例：link-waits-1 ..
      +kind: LinkKind
      .. depends_on / waits_for / supplies / reviews / delegates_to ..
      +from: LinkEndpoint
      +to: LinkEndpoint
      .. participant 或 artifact 端点 ..
    }

    class "PolicyContext\n策略上下文" as Policy #FFFDFC {
      +approvalState: ApprovalState
      .. none / awaiting_review / approved / rejected ..
      +retryState: RetryState
      .. idle / awaiting_feedback / exhausted ..
    }

    class "EntityTombstone\n实体墓碑" as Tombstone #FFFDFC {
      +entityId: string
      .. 例：session-s ..
      +entityKind: RetiredEntityKind
      .. participant / session / capability / link / artifact ..
      +retiredAt: Timestamp
      +reasonRef: string
      .. optional ..
    }

    class "ObservationEntry\n外部观察（有序）" as Observation #FFFDFC {
      +sequenceNo: SequenceNo
      .. 例：1 → Obs#001 ..
      +source: ActorRef
      .. 例：(actorId=human-h, kind=human) ..
      +payloadRef: ContentRef
      .. 例：content://req-login ..
      +receivedAt: Timestamp
      .. 例：2026-08-07T10:00:00Z ..
    }
  }

  package "coordination · 协作快照与变更" #E5EDE5 {

    class "CollaborationSnapshot\n某一时刻协作世界" as Snapshot #F9FCF8 {
      +snapshotRef: SnapshotRef
      .. 例：snap-S1；beforeRef / afterRef 解析目标 ..
      +epochId: EpochId
      .. 例：42；重放版本对齐 ..
      +participants: Map<ActorId, Participant>
      +artifacts: Map<ArtifactId, WorkArtifact>
      +links: Map<LinkId, CollaborationLink>
      +sessions: Map<SessionId, CommunicationSession>
      +capabilities: Map<CapabilityId, ScopedCapability>
      +policyContext: PolicyContext
      +auditTail: List<ObservationEntry>
      .. append-only；观察本身不改协作图 ..
      +retiredEntities: List<EntityTombstone>
    }

    Snapshot *-down- Participant
    Snapshot *-down- Artifact
    Snapshot *-down- Capability
    Snapshot *-down- Session
    Snapshot *-down- Link
    Snapshot *-down- Policy
    Snapshot *-down- Observation
    Snapshot *-down- Tombstone
  }

  package "coordination · 变更与引用" #F3E5DC {

    class "CoordinationChange\n已提交协调步骤" as Change #FFF9F6 {
      +changeId: ChangeId
      .. 例：chg-001 ..
      +recordedAt: Timestamp
      +epochId: EpochId
      .. 例：42；同链须一致 ..
      +operationTypeId: OperationTypeId
      .. 例：introduce_artifact / delegate ..
      +templateRef: OperationTemplateRef
      .. optional；版本化模板指针 ..
      +beforeRef: SnapshotRef
      +afterRef: SnapshotRef
      .. 例：snap-S0 → snap-S1 ..
      +matchBindings: List<MatchBinding>
      .. 例：task/from/to/capability；重放 recipe ..
      +targets: List<TargetRef>
      .. 由 matchBindings 派生；legacy 回退 ..
      +initiator: ActorRef
      .. 例：(actorId=planner-p, kind=agent) ..
      +involved: List<ActorRef>
      +authorization: List<EvidenceRef>
      +external: List<EvidenceRef>
      +createdSessionRefs: List<SessionId>
      .. 例：[session-s] ..
      +visibility: ChangeVisibility
      .. internal / external / administrative；必填 ..
      --
      <b>不含 payload</b>
    }

    class "CoordinationIntent\n<<transient>>\n准入前意图" as Intent #FFFDFC {
      +initiator: ActorRef
      +operationTypeId: OperationTypeId
      +matchBindings: List<MatchBinding>
      .. 例：delegate task/from/to/capability ..
      +targets: List<TargetRef>
      .. 由 matchBindings 派生 ..
      +external: List<EvidenceRef>
      .. optional ..
    }

    class "ProposedChange\n<<transient>>\n已准入待提交" as Proposed #FFFDFC {
      +intent: CoordinationIntent
      +beforeRef: SnapshotRef
    }

    class "TargetRef\n变更匹配目标" as Target #FFFDFC {
      +kind: TargetKind
      .. artifact / participant / session / capability / link ..
      +id: string
      .. 例：task-T / planner-p ..
    }

    class "MatchBinding\n命名重放绑定" as MatchBinding #FFFDFC {
      +role: MatchRole
      .. task / from / to / capability / session / link ..
      +artifactId: ArtifactId
      .. role=task|artifact 时 ..
      +actorId: ActorId
      .. role=from|to|participant 时 ..
      +capabilityId: CapabilityId
      .. role=capability 时 ..
    }

    class "OperationTemplateRef\n模板版本指针" as TemplateRef #FFFDFC {
      +operationTypeId: string
      +revision: string
      .. 例：delegate@1 ..
    }

    class "ActorRef\n事件侧 Actor 引用" as ActorRef #FFFDFC {
      +actorId: ActorId
      +kind: ActorKind
    }

    class "EvidenceRef\n授权 / 外部证据" as Evidence #FFFDFC {
      +evidenceId: string
      +kind: EvidenceKind
      .. policy / approval / observation / receipt ..
      +contentRef: ContentRef
    }

    Intent --> Proposed : admit 前
    Proposed ..> Change : commit 后
    Change *-- Target
    Change *-- MatchBinding
    Change *-- ActorRef
    Change *-- Evidence
    Change ..> TemplateRef : templateRef?
  }

  package "structure · Agent 组合原语" #EDE8F0 {

    class "CompositionIntent\nAgent 结构动词" as Composition #FFFDFC {
      +operator: CompositionOperatorKind
      .. attach / delegate / fork / nest / rewire / isolate / close ..
      +initiator: ActorRef
      +footprint: Footprint
      .. Agent 声明并发隔离范围 ..
      +targets: List<TargetRef>
      +openInterface: Interface
      .. 代码字段 interface? optional ..
      +binds: GoalOrOutcome
      .. optional；Goal 或 Outcome ..
    }

    class "Footprint\n实体触达集合" as Footprint #FFFDFC {
      +artifactIds: Set<ArtifactId>
      +participantIds: Set<ActorId>
      +sessionIds: Set<SessionId>
      +capabilityIds: Set<CapabilityId>
      +linkIds: Set<LinkId>
      --
      effectiveFootprintOfCompositionIntent()
      .. 从 targets 派生；并发判定权威 ..
    }

    class "DerivedDiagnosticView\n诊断摘要" as DerivedView #FFFDFC {
      +kind: serial | parallel | nest | box
      .. 只读 derive；不可用于调度 ..
    }

    class "RunHistory\n运行历史" as History #FFFDFC {
      +segments: List<TraceSegment>
      .. observation | rewrite(CoordinationChange) ..
    }

    Composition --> Footprint
    Composition ..> Intent : toCoordinationIntent()
    History .. Change : rewrite 段
    History .. Observation : observation 段
    Snapshot .. DerivedView : deriveDiagnosticSummary()
  }

  package "consistency · 世界完整性" #E8EEF5 {

    class "CoreViolation\n语义违规" as Violation #F8FAFD {
      +code: CoreViolationCode
      .. snapshot_integrity / actor_kind_mismatch ..
      +message: string
      +path: string
      .. optional ..
      +expected: string
      +actual: string
    }

    class "validateSnapshotIntegrity\n快照完整性" as ValidateIntegrity #F8FAFD {
      +check: Map key 对齐
      +check: ActorRef kind 一致
      +check: policy reviewers 已注册
      +check: auditTail 序列连续
    }

    class "validateCollaborationWorld\n世界校验" as ValidateWorld #F8FAFD {
      +integrity: validateSnapshotIntegrity
      +history: validateAuditTailMatchesHistory
    }

    Snapshot .. ValidateIntegrity
    ValidateWorld .. ValidateIntegrity
    ValidateIntegrity .. Violation : CoreError
  }

  package "Runtime · 非 core 导出" #E5ECEE {

    class "OperationTemplate\n<<runtime>>\n合法操作模板" as Operation #F8FBFB {
      +operationTypeId: OperationTypeId
      +requires: List<ContractRef>
      +ensures: List<ContractRef>
    }

    class "CoordinationRuntime\n<<runtime>>\nChange 提交边界" as Runtime #F8FBFB {
      +admit(snapshot, intent): Decision
      +commit(change): SnapshotRef
      +append(change): ChangeId
      +replay(before, changes): Verification
    }

    Change --> Operation : 命中模板
    Change --> Runtime : admit · commit · append · replay
  }
}

' 跨包引用关系
Observation ..> Snapshot : append auditTail
Snapshot .. Change : beforeRef / afterRef
ActorRef ..> Participant : actorId 解析
Artifact ..> ActorRef : owner
Capability ..> Artifact : scope.artifactId

note bottom of Change
  <b>读图纪律（core 已编码）</b>
  ① appendObservation 只追加 auditTail，不改协作图。
  ② Actor 提交 Intent；ProposedChange 为瞬态；CoordinationChange 为已提交事实。
  ③ matchBindings 为重放 recipe；targets 为派生/legacy 回退。
  ④ deriveDiagnosticSummary 为只读诊断；调度语义待新 ADR。
  ⑤ OperationTemplate / CoordinationRuntime 属 @cantilune/runtime。
end note

footer <color:#6E6963>代码锚点：collaborationSnapshot.ts · coordinationChange.ts · consistency/* · structure/operators.ts · structure/derive.ts</color>
@enduml
